# The url of your database
DATABASE_URL=mongodb://127.0.0.1/your-database-name
# This secret is used by payload for signing jwts
PAYLOAD_SECRET=YOUR_SECRET_HERE
# This secret is used for live preview
PREVIEW_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash at the end
NEXT_PUBLIC_BASE_URL=<YOUR_BASE_URL>
# Used as key for cookies
NEXT_PUBLIC_SITE_SHORTCUT=<OPTIONAL_SITE_SHORTCUT>
# Define the local schema type
NEXT_PUBLIC_SCHEMA_TYPE=<OPTIONAL_SCHEMA_TYPE>