# The url of your database
DATABASE_ADAPTER=sqlite
DATABASE_URL=file:./database.db
# Production example: DATABASE_ADAPTER=postgres with a Neon/Postgres connection URL
# BLOB_READ_WRITE_TOKEN is required for persistent uploads on Vercel
BLOB_READ_WRITE_TOKEN=
# This secret is used by payload for signing jwts
PAYLOAD_SECRET=YOUR_SECRET_HERE
# This secret is used for live preview
PREVIEW_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash at the end
NEXT_PUBLIC_BASE_URL=<YOUR_BASE_URL>
# Used as key for cookies
NEXT_PUBLIC_SITE_SHORTCUT=<OPTIONAL_SITE_SHORTCUT>
# Define the local schema type
NEXT_PUBLIC_SCHEMA_TYPE=<OPTIONAL_SCHEMA_TYPE>

# Optional. If omitted, no Google Analytics script is sent to visitors.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
